        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"fulano@qa.com\",\n  \"password\": \"teste\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
